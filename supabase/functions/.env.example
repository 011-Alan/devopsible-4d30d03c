# AWS Cloud Sandbox Configuration for DevOpsible
# Place your real AWS credentials here for real cloud sandbox execution:

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Optional: If using temporary session tokens (e.g. AWS Academy, STS, or IAM Identity Center)
# AWS_SESSION_TOKEN=your_aws_session_token

# Required IAM Policies for the AWS User/Role:
# - AmazonECS_FullAccess (For Docker container task provisioning on AWS Fargate)
# - AmazonEC2ContainerRegistryPowerUser (For pushing/pulling images to/from AWS ECR)
# - AmazonEKSClusterPolicy & AmazonEKSWorkerNodePolicy (For Kubernetes cluster operations)
